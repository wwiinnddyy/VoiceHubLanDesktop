<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      LanMountainDesktop.AirAppSdk 发布在 GitHub Packages。
      GitHub Packages 即使托管公开包，还原时也必须提供凭据。
      本地开发请用 `dotnet nuget add source` 配置带 read:packages 权限的 PAT，
      不要把 token 写进本文件并提交。CI 使用仓库 secret LANMOUNTAIN_PACKAGES_TOKEN 注入。
    -->
    <add key="lanmountain" value="https://nuget.pkg.github.com/wwiinnddyy/index.json" />
  </packageSources>
</configuration>
