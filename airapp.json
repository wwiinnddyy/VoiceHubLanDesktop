  "author": "LaoShui",
  "description": "显示声动校园广播电台的公开歌单，支持实时更新和自定义刷新。",
  "entranceAssembly": "VoiceHubLanDesktop.dll",
  "runtime": {
    "mode": "in-process",
    "capabilities": ["desktop-component"]
  },
  "components": [
    {
      "id": "voicehub-playlist",
      "name": "声动校园歌单",
      "defaultWidth": 3,
      "defaultHeight": 4
    }
  ]
}
